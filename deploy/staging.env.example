# Placeholder names only. Load real values from a file outside the repository.
PLATFORM_ENV=prelaunch
PLATFORM_DATABASE_URL=postgresql+psycopg://seccraft_app:REPLACE@EXISTING_SUPABASE_DB_HOST:5432/postgres?sslmode=require
CONTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@EXISTING_SUPABASE_DB_HOST:5432/postgres?sslmode=require
CONTENT_DATABASE_RUNTIME_ROLE=seccraft_app
CONTENT_BACKUP_DATABASE_URL=postgresql://postgres:REPLACE@EXISTING_SUPABASE_DB_HOST:5432/postgres?sslmode=require
PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:5173
PLATFORM_AUTO_CREATE_TABLES=false
PLATFORM_ENABLE_API_DOCS=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE
# Usually omit SUPABASE_JWT_SECRET and use the default JWKS URL. Set it only for legacy HS256 projects.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_REQUIRE_VERIFIED_EMAIL=true
CONTENT_STORAGE_BACKEND=supabase
CONTENT_STORAGE_BUCKET=seccraft-content-staging
CONTENT_IMPORT_ALLOW_NONLOCAL=true
CONTENT_RELEASE_ID=prelaunch-YYYYMMDD-N
STAGING_API_URL=http://127.0.0.1:8000
STAGING_PENDING_JWT=REPLACE_SHORT_LIVED_TOKEN
STAGING_APPROVED_JWT=REPLACE_SHORT_LIVED_TOKEN
STAGING_APPROVED_WITH_PROGRESS_JWT=REPLACE_SHORT_LIVED_TOKEN
# Frontend build/runtime values (the anon key is intentionally public; never use the service key here).
VITE_API_BASE=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE
CONTENT_BOUNDARY_BUILD=1
