# Identifiers only. Copy outside the repository and supply real staging-only secrets.
PLATFORM_ENV=staging
PLATFORM_DATABASE_URL=postgresql+psycopg://seccraft_app:REPLACE@STAGING_DB_HOST:5432/seccraft_staging?sslmode=require
CONTENT_MIGRATION_DATABASE_URL=postgresql+psycopg://seccraft_migrator:REPLACE@STAGING_DB_HOST:5432/seccraft_staging?sslmode=require
CONTENT_DATABASE_RUNTIME_ROLE=seccraft_app
CONTENT_BACKUP_DATABASE_URL=postgresql://seccraft_backup:REPLACE@STAGING_DB_HOST:5432/seccraft_staging?sslmode=require
PLATFORM_ALLOWED_ORIGINS=https://STAGING_FRONTEND_HOST
PLATFORM_AUTO_CREATE_TABLES=false
PLATFORM_ENABLE_API_DOCS=false
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE
SUPABASE_SERVICE_ROLE_KEY=REPLACE
SUPABASE_JWT_ISSUER=https://STAGING_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=REPLACE_IF_USING_HS256
SUPABASE_REQUIRE_VERIFIED_EMAIL=true
CONTENT_STORAGE_BACKEND=supabase
CONTENT_STORAGE_BUCKET=seccraft-content-staging
CONTENT_STORAGE_ROOT=/tmp/seccraft-content-storage-fallback-disabled
CONTENT_IMPORT_ALLOW_NONLOCAL=true
CONTENT_RELEASE_ID=staging-YYYYMMDD-N
STAGING_API_URL=https://STAGING_API_HOST
STAGING_FRONTEND_URL=https://STAGING_FRONTEND_HOST
STAGING_PENDING_JWT=REPLACE_SHORT_LIVED_TOKEN
STAGING_APPROVED_JWT=REPLACE_SHORT_LIVED_TOKEN
STAGING_UNAUTHORIZED_APPROVED_JWT=REPLACE_SHORT_LIVED_TOKEN
VITE_API_URL=https://STAGING_API_HOST/api/v1
CONTENT_BOUNDARY_BUILD=1
