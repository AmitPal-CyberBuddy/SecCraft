# Copy to ignored root .env and replace every placeholder before starting containers.
POSTGRES_DB=seccraft
POSTGRES_USER=seccraft
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# For local HTTP on http://localhost:8080; set the exact HTTPS browser origin in production.
PLATFORM_ALLOWED_ORIGINS=http://localhost:8080
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Optional Supabase Auth. Leave these blank for guest-only service; account sync fails closed.
# When enabled, use matching project values on the server and public frontend. Never add a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_REQUIRE_VERIFIED_EMAIL=true
SUPABASE_EMAIL_REDIRECT_URL=

# Public frontend build values; use the same Supabase project as the backend if accounts are enabled.
VITE_BASE=/
VITE_API_BASE=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
