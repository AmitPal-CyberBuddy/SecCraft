{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seccraft.example/schemas/content-release.schema.json",
  "title": "SecCraft authored content release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "synthetic", "paths", "lessons", "labs", "items", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "$ref": "#/$defs/id" },
    "synthetic": { "type": "boolean" },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "minItems": 1 },
    "lessons": { "type": "array", "items": { "$ref": "#/$defs/lesson" } },
    "labs": { "type": "array", "items": { "$ref": "#/$defs/lab" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 100 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "maturity", "moduleIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "maturity": { "enum": ["preview", "published", "coming-soon"] },
        "moduleIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "lesson": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pathId", "moduleId", "title", "body", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "pathId": { "$ref": "#/$defs/id" }, "moduleId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 },
        "access": { "enum": ["learning-content", "public-sample"] }
      }
    },
    "lab": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pathId", "moduleId", "title", "instructions", "artifactIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "pathId": { "$ref": "#/$defs/id" }, "moduleId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 }, "instructions": { "type": "string", "minLength": 1 },
        "artifactIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "pathId", "moduleId", "kind", "grading", "prompt", "privateKey", "solution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "pathId": { "$ref": "#/$defs/id" }, "moduleId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["practice", "verification"] }, "grading": { "enum": ["practice", "verified"] },
        "prompt": { "type": "string", "minLength": 1 }, "privateKey": { "type": "string", "minLength": 1 }, "solution": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "practice" } } }, "then": { "properties": { "grading": { "const": "practice" } } } },
        { "if": { "properties": { "kind": { "const": "verification" } } }, "then": { "properties": { "grading": { "const": "verified" } } } }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "filename", "mediaType", "sha256", "size", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "filename": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "mediaType": { "type": "string", "minLength": 3 }, "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 }, "access": { "enum": ["learning-content", "public-sample"] }
      }
    }
  }
}
