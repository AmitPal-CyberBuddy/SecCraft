# Server-only settings. Never commit a real .env file.
PLATFORM_ENV=development
PLATFORM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
PLATFORM_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_REQUIRE_VERIFIED_EMAIL=true
SUPABASE_EMAIL_REDIRECT_URL=https://YOUR_APP_ORIGIN/SecCraft/account?sent=1

# Owner bootstrap: insert the owner's Supabase Auth UUID into public.platform_admins after migration.
# No user-selectable role exists. Keep account recovery details and database credentials private.
PLATFORM_ENABLE_API_DOCS=false
PLATFORM_AUTO_CREATE_TABLES=false

# Optional feedback intake: keep disabled (blank) until migrations and ingress limits are ready.
# Generate a separate random secret of at least 32 bytes; use the same value across API workers.
FEEDBACK_HMAC_SECRET=
FEEDBACK_USER_HOUR=5
FEEDBACK_USER_DAY=15
FEEDBACK_GUEST_HOUR=3
FEEDBACK_GUEST_DAY=10
FEEDBACK_IP_HOUR=30
FEEDBACK_IP_DAY=100
FEEDBACK_RETENTION_DAYS=180
# Schedule daily: python -m app.services.feedback_retention
# Uvicorn's FORWARDED_ALLOW_IPS must name only trusted ingress peers; never '*'.
