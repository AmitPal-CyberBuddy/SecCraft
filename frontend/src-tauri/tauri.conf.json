{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "WiFiForge",
    "version": "2.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "dialog": { "all": true },
      "fs": { "all": true, "scope": ["$APP/*", "$RESOURCE/*", "$APPDATA/*"] },
      "http": { "all": true, "scope": ["https://*"] },
      "notification": { "all": true },
      "globalShortcut": { "all": true },
      "os": { "all": true },
      "path": { "all": true }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "WiFiForge Enterprise v2.1 — Zero-cost Local-first Offline Kali-ready",
      "deb": { "depends": [] },
      "externalBin": [],
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "identifier": "com.wififorge.enterprise",
      "longDescription": "WiFiForge — Enterprise wireless PT academy — 20 modules × 80 lessons, 50+ commands, zero-cost local-first offline Kali-ready production PWA desktop app — Rust backend Tauri — system tray global shortcuts offline-first auto-update",
      "macOS": { "entitlements": null, "exceptionDomain": "", "frameworks": [], "providerShortName": null, "signingIdentity": null },
      "resources": [],
      "shortDescription": "Wireless Pentest Academy — Enterprise v2.1",
      "targets": "all",
      "windows": { "certificateThumbprint": null, "digestAlgorithm": "sha256", "timestampUrl": "" }
    },
    "security": { "csp": null },
    "updater": { "active": true, "dialog": true, "endpoints": ["https://wififorge.local/api/updater/{{target}}/{{current_version}}"], "pubkey": "" },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "WiFiForge — Wireless Pentest Academy • Enterprise v2.1",
        "width": 1400,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    },
    "cli": { "description": "WiFiForge CLI — Enterprise", "args": [] }
  }
}
