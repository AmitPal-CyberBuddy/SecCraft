# Public browser configuration only. Supabase anon keys are public, but RLS/auth settings must still be correct.
# Do not put a Supabase service-role key, database URL, JWT signing secret, or any other server secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional API origin (host only, no /api suffix). Unset in local dev to use Vite's /api proxy.
# Example: VITE_API_BASE=https://api.example.com
VITE_API_BASE=

# Optional build-time CSP origins are derived from the two values above.
